# Supabase (self-hosted at supabase.arrowair.com)
# Set for local dev; in production these are provided by Openship build env.
VITE_SUPABASE_URL=https://supabase.arrowair.com
VITE_SUPABASE_PUBLISHABLE_KEY=<anon key — ask in #openship or copy from Openship project env>

# --- GitHub OAuth (feature-flagged; email auth is always on) -----------------
# Frontend flag: set to true ONLY where the backing GoTrue instance has the
# GitHub provider configured (prod). The OAuth app exists:
#   client ID: Ov23liqSDMPkyBhht5hG
#   callback:  https://supabase.arrowair.com/auth/v1/callback
# The client SECRET lives outside this repo (Hex's .secrets/) — never commit it.
VITE_GITHUB_AUTH_ENABLED=false

# Server-side (GoTrue container env on the prod box, NOT read by Vite —
# documented here so the wiring is in one place):
#   GOTRUE_EXTERNAL_GITHUB_ENABLED=true
#   GOTRUE_EXTERNAL_GITHUB_CLIENT_ID=Ov23liqSDMPkyBhht5hG
#   GOTRUE_EXTERNAL_GITHUB_SECRET=<from .secrets/ — DO NOT COMMIT>
#   GOTRUE_EXTERNAL_GITHUB_REDIRECT_URI=https://supabase.arrowair.com/auth/v1/callback
